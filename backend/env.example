# Server Configuration
PORT=5000
NODE_ENV=development

# Worker Configuration (demo mode - generates dummy data every N minutes)
INGESTION_INTERVAL_MINUTES=15

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
